{
  "name": "@lexomis/opencode-agent-switcher",
  "version": "0.1.1",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lexomis/opencode-agent-switcher.git"
  },

  "main": "./dist/index.js",
  "files": ["dist/"],
  "exports": {
    ".": "./dist/index.js",
    "./server": "./dist/index.js",
    "./tui": "./dist/tui.js"
  },

  "scripts": {
    "build:tsc": "tsc --noEmit",
    "build:tui": "node scripts/build.mjs",
    "postbuild": "node scripts/create-dev-symlinks.mjs",
    "build": "pnpm build:tsc && pnpm build:tui",
    "lint:biome": "${BIOME:-biome} check --error-on-warnings",
    "lint:fix": "${BIOME:-biome} check --write --unsafe --max-diagnostics=0",
    "lint": "pnpm lint:fix && pnpm lint:biome",
    "test:smoke": "node scripts/smoke-server.mjs",
    "test:ts": "vitest run --config vitest.config.ts",
    "test": "pnpm test:smoke && pnpm test:ts"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,json,jsonc}": [
      "biome format --write --no-errors-on-unmatched"
    ]
  },

  "dependencies": {
    "@opencode/plugin": "2.0.26",
    "@opencode/schema": "2.0.26",
    "yaml": "2.8.3"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-typescript": "7.27.1",
    "@biomejs/biome": "2.5.14",
    "@opencode/client": "2.0.26",
    "@opentui/core": "0.5.17",
    "@opentui/solid": "0.5.17",
    "@types/node": "24.10.0",
    "babel-preset-solid": "1.9.12",
    "esbuild": "0.28.2",
    "lint-staged": "17.3.0",
    "solid-js": "1.9.12",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "packageManager": "pnpm@12.9.0+sha512.8f64efa0b792986ca98ae568791bcd7722807e274c4f0c1d9853c62116495c584119db98762a2a5343b1684d361b9ae26fdd16d551666d7635346d3fae830ddd"
}
