{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"jsx": "preserve",
		"jsxImportSource": "@opentui/solid",
		"types": ["node"],
		"skipLibCheck": true
	},
	"include": ["index.ts", "tui.ts", "src/**/*.ts", "src/**/*.tsx"],
	"exclude": ["src/tui-compiled", "src/tui/types"]
}
